// Overview of the current browser-server transport, not a connection state machine.
digraph pushconnect {
    label="Browser-server communication: MQTT over WebSocket";
    labelloc=t;
    rankdir=LR;

    widgets [label="Wires and browser components"];
    broker [label="Cotonic MQTT broker"];
    bridge [label="Cotonic origin bridge"];
    transport [label="MQTT WebSocket transport"];
    server [label="Zotonic MQTT transport"];

    widgets -> broker [dir=both, label="publish / subscribe"];
    broker -> bridge [dir=both];
    bridge -> transport [dir=both];
    transport -> server [dir=both, label="WebSocket (mqtt subprotocol)"];
}
