%% -*- mode: erlang -*-

{require_min_otp_vsn, "19"}.

{erl_opts, [
  {parse_transform, lager_transform},

  %% When you add patform defines, make sure they are picked up in zotonic_compile.erl
  {platform_define, "^([0-9]+)", namespaced_dicts},
  {platform_define, "^([0-9]+|R16)", coding_utf8},
  {platform_define, "^(R16|17)", no_ssl},
  {platform_define, "^R16", lists_nofiltermap},
  {platform_define, "^(19|2)", rand_only},
  {platform_define, "^(R|1|20)", fun_stacktrace}
 ]
}.

{deps,
 [
  {edown, {git, "https://github.com/uwiger/edown.git", {tag, "0.8.4"}}},
  {goldrush, {git, "https://github.com/DeadZen/goldrush.git", {tag, "0.1.6"}}},
  {lager, {git, "https://github.com/erlang-lager/lager.git", {tag, "3.9.2"}}},
  {parse_trans, {git, "https://github.com/uwiger/parse_trans.git", {tag, "3.3.0"}}},
  {certifi, {git, "https://github.com/certifi/erlang-certifi.git", {tag, "2.5.1"}}},
  {cf, {git, "https://github.com/project-fifo/cf.git", {tag, "v0.3.1"}}},
  {erlware_commons, {git, "https://github.com/erlware/erlware_commons.git", {tag, "v1.7.0"}}},
  {depcache, {git, "https://github.com/zotonic/depcache.git", {tag, "1.6.0"}}},
  {bert, {git, "https://github.com/zotonic/bert.erl.git", {ref, "1efd05a1a0288ec62e1df0b8af42f6d96cd0516b"}}},
  {dh_date, {git, "https://github.com/zotonic/dh_date.git", {ref, "473ad8c47379939aeca919547a7d977eaf34c27b"}}},
  {eiconv, {git, "https://github.com/zotonic/eiconv.git", {ref, "bfd3df519921947c6da5e5d596bd5f19e74dec69"}}},
  {gen_smtp, {git, "https://github.com/Vagabond/gen_smtp.git", {ref, "813d0258eeac6b9cc4ce47b7a9616ec5f8e43c80"}}},
  {mimetypes, {git, "https://github.com/zotonic/mimetypes.git", {ref, "a60b350819c8ba5602ed85b9d0050cc8e3cb1152"}}},
  {mochiweb, {git, "https://github.com/zotonic/mochiweb.git", {branch, "master"}}},
  {dispatch_compiler, {git, "https://github.com/zotonic/dispatch_compiler.git", {tag, "1.0.0-alpha1"}}},
  {ua_classifier, {git, "https://github.com/zotonic/ua_classifier.git", {ref, "37ba6bb25576c225bf414d1517de908635612413"}}},
  {webzmachine, {git, "https://github.com/zotonic/webzmachine.git", {branch, "master"}}},
  {z_stdlib, {git, "https://github.com/zotonic/z_stdlib.git", {branch, "0.x"}}},
  {jsx, {git, "https://github.com/talentdeficit/jsx.git", {tag, "v3.0.0"}}},
  {jsxrecord, {git, "https://github.com/zotonic/jsxrecord.git", {tag, "1.1.0"}}},
  {bear, {git, "https://github.com/folsom-project/bear.git", {tag, "0.8.5"}}},
  {meck, {git, "https://github.com/eproxus/meck", {tag, "0.8.10"}}},
  {folsom, {git, "https://github.com/folsom-project/folsom.git", {tag, "0.8.7"}}},
  {hut, {git, "https://github.com/tolbrino/hut.git", {ref, "230cd4557a344665378382de374e6a1b5456c822"}}},
  {setup, {git, "https://github.com/uwiger/setup.git", {tag, "2.0.2"}}},
  {exometer_core, {git, "https://github.com/Feuerlabs/exometer_core.git", {tag, "v1.5.7"}}},
  {filezcache, {git, "https://github.com/mworrell/filezcache.git", {ref, "870f69aca461dbf1e3fbfd1642b925efbce64619"}}},
  {jobs, {git, "https://github.com/uwiger/jobs.git", {tag, "0.7.1"}}},
  {s3filez, {git, "https://github.com/mworrell/s3filez.git", {ref, "8d9ba7f2eade956cea87167d0d786dc942000ea0"}}},
  {proper, {git, "https://github.com/manopapad/proper.git", {ref, "16f9f7cb181f41ffb882c4a31052275dfad16ee1"}}},
  {diffy, {git, "https://github.com/mmzeeman/diffy.git", {ref, "ffb56061362865b13bad1841d759a5990b0f8f17"}}},
  {gproc, {git, "https://github.com/uwiger/gproc.git", {ref, "ed37980aa895cd3643e101f36cc2c3bdf1daa7fc"}}},
  {emqtt, {git, "https://github.com/zotonic/emqtt.git", {ref, "4abe34a6194f632c6589a4ca4954447a02b41b1d"}}},
  {poolboy, {git, "https://github.com/devinus/poolboy.git", {tag, "1.5.1"}}},
  {epgsql, {git, "https://github.com/epgsql/epgsql.git", {tag, "3.4.0"}}},
  {qdate_localtime, {git, "https://github.com/choptastic/qdate_localtime.git", {ref, "245069f9619c0d68a41c8c9f9da84c4fcdded17f"}}},
  {qdate, {git, "https://github.com/choptastic/qdate.git", {ref, "accda0db1afce64d1689a6192713dd69ae057e3f"}}},
  {recon, {git, "https://github.com/ferd/recon.git", {tag, "2.5.6"}}},
  {jiffy, {git, "https://github.com/davisp/jiffy.git", {tag, "1.0.9"}}},
  {oauth, {git, "https://github.com/tim/erlang-oauth.git", {tag, "v1.6.0"}}},
  {exif, {git, "https://github.com/nlfiedler/erlang-exif.git", {ref, "fda65623dce07bb21948306c91020bc644253460"}}},
  {termit, {git, "https://github.com/erlangpack/termit", {ref, "c1d0dde3b184a48f8253f0f3fd4b73a2eba4905e"}}},
  {bcrypt, {git, "https://github.com/erlangpack/bcrypt", {tag, "1.1.5"}}},
  {erlpass, {git, "https://github.com/ferd/erlpass.git", {tag, "1.0.4"}}},
  {stacktrace_compat, {git, "https://github.com/zotonic/stacktrace_compat.git", {ref, "d2a987e1569b39b826a9bf165d94749ace134638"}}},
  {ssl_verify_fun, {git, "https://github.com/deadtrickster/ssl_verify_fun.erl.git", {tag, "1.1.5"}}},
  {locus, {git, "https://github.com/g-andrade/locus.git", {tag, "1.16.1"}}},
  {idna, {git, "https://github.com/benoitc/erlang-idna", {tag, "1.2.0"}}},
  {mimerl, {git, "https://github.com/benoitc/mimerl", {tag, "1.0.2"}}},
  {metrics, {git, "https://github.com/benoitc/erlang-metrics", {tag, "1.0.1"}}}
 ]
}.

{xref_checks, [undefined_function_calls,
               locals_not_used,
               deprecated_function_calls]}.

%% Make a symlink to the modules directory to make it possible to have direct includes.
{post_hooks, [
  {compile, "mkdir -p _build/default/lib/zotonic && ln -sfn ../../../../modules _build/default/lib/zotonic/modules"}
]}.

