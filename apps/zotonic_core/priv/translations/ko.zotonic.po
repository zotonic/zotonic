#: zotonic_mod_admin_keyword/priv/templates/admin_keyword.tpl:204
msgid "Cells show the number of content items using both keywords."
msgstr "각 셀에는 두 키워드를 모두 사용한 콘텐츠 항목의 수가 표시됩니다."

#: zotonic_mod_admin_keyword/priv/templates/admin_keyword.tpl:208
