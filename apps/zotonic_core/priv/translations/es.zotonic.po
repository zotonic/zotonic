#: zotonic_mod_logging/priv/templates/admin_log_email.tpl:116
msgid "<ul>\n"
"                                            <li><b>Sending</b>: the email is being sent to the remote mailer</li>\n"
"                           <li><b>Sent</b>: the email has been sent to the remote mailer</li>\n"
"      <li><b>Relayed</b>: the remote mailer reports that the email is relayed to the next server</li>\n"
"                                            <li><b>Bounce</b>: the email bounced back from a remote mailer, this is a fatal error</li>\n"
"                                            <li><b>Failed</b>: the remote mailer did not accept our email, no further retries</li>\n"
"                                            <li><b>Delivery retry</b>: we could not send the email and will retry later</li>\n"
"        <li><b>Blocked</b>: the recipient’s email address is blocked, check the email address status</li>\n"
"                                            <li><b>Received</b>: a remote mailer sent email to us</li>\n"
"              </ul>"
msgstr "<ul>\n"
"                                            <li><b>Enviando</b>: el correo electrónico se está enviando al servidor de correo remoto</li>\n"
"                           <li><b>Enviado</b>: el correo electrónico se ha enviado al servidor de correo remoto</li>\n"
"      <li><b>Retransmitido</b>: el servidor de correo remoto informa de que el correo electrónico se ha reenviado al siguiente servidor</li>\n"
"                                            <li><b>Mensaje devuelto</b>: el correo electrónico ha sido devuelto por un servidor de correo remoto; se trata de un error grave</li>\n"
"                                            <li><b>Falló</b>: el servidor de correo remoto no ha aceptado nuestro correo electrónico; no se realizarán más intentos</li>\n"
"                                            <li><b>Nuevo intento de entrega</b>: no hemos podido enviar el correo electrónico y lo volveremos a intentar más tarde</li>\n"
"        <li><b>Bloqueado</b>: la dirección de correo electrónico del destinatario está bloqueada; comprueba el estado de la dirección</li>\n"
"                                            <li><b>Recibido</b>: un servidor de correo remoto nos ha enviado un correo electrónico</li>\n"
"              </ul>"

