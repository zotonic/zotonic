#: zotonic_mod_logging/priv/templates/admin_log_email.tpl:116
msgid "<ul>\n"
"                                            <li><b>Sending</b>: the email is being sent to the remote mailer</li>\n"
"                           <li><b>Sent</b>: the email has been sent to the remote mailer</li>\n"
"      <li><b>Relayed</b>: the remote mailer reports that the email is relayed to the next server</li>\n"
"                                            <li><b>Bounce</b>: the email bounced back from a remote mailer, this is a fatal error</li>\n"
"                                            <li><b>Failed</b>: the remote mailer did not accept our email, no further retries</li>\n"
"                                            <li><b>Delivery retry</b>: we could not send the email and will retry later</li>\n"
"        <li><b>Blocked</b>: the recipient’s email address is blocked, check the email address status</li>\n"
"                                            <li><b>Received</b>: a remote mailer sent email to us</li>\n"
"              </ul>"
msgstr "<ul>\n"
"                                            <li><b>A enviar</b>: o e-mail está a ser enviado para o servidor de e-mail remoto</li>\n"
"                           <li><b>Enviado</b>: o e-mail foi enviado para o servidor de e-mail remoto</li>\n"
"      <li><b>Retransmitido</b>: o servidor de correio remoto informa que o e-mail foi reencaminhado para o servidor seguinte</li>\n"
"                                            <li><b>Mensagem devolvida</b>: o e-mail foi devolvido por um servidor de e-mail remoto; trata-se de um erro fatal</li>\n"
"                                            <li><b>Falha</b>: o servidor de e-mail remoto não aceitou o nosso e-mail; não haverá mais tentativas</li>\n"
"                                            <li><b>Nova tentativa de entrega</b>: não foi possível enviar o e-mail e será feita uma nova tentativa mais tarde</li>\n"
"        <li><b>Bloqueado</b>: o endereço de e-mail do destinatário está bloqueado; verifique o estado do endereço de e-mail</li>\n"
"                                            <li><b>Recebido</b>: um servidor de e-mail remoto enviou-nos um e-mail</li>\n"
"              </ul>"

