msgstr "Chào mừng bạn! Trang đang xem là trang mặc định của máy chủ web Zotonic. Việc trang này xuất hiện có thể có nghĩa là website bạn muốn truy cập chưa được cấu hình đúng."

#: zotonic_site_status/priv/templates/logon.tpl:34
msgid "You can find the password in ~/.zotonic/[version]/zotonic.config."
msgstr "Bạn có thể tìm mật khẩu trong ~/.zotonic/[version]/zotonic.config."

