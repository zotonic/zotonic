#: zotonic_mod_logging/priv/templates/admin_log_email.tpl:116
msgid "<ul>\n"
"                                            <li><b>Sending</b>: the email is being sent to the remote mailer</li>\n"
"                           <li><b>Sent</b>: the email has been sent to the remote mailer</li>\n"
"      <li><b>Relayed</b>: the remote mailer reports that the email is relayed to the next server</li>\n"
"                                            <li><b>Bounce</b>: the email bounced back from a remote mailer, this is a fatal error</li>\n"
"                                            <li><b>Failed</b>: the remote mailer did not accept our email, no further retries</li>\n"
"                                            <li><b>Delivery retry</b>: we could not send the email and will retry later</li>\n"
"        <li><b>Blocked</b>: the recipient’s email address is blocked, check the email address status</li>\n"
"                                            <li><b>Received</b>: a remote mailer sent email to us</li>\n"
"              </ul>"
msgstr "<ul><li><b>Đang gửi</b>: email đang được gửi đến máy chủ thư từ xa</li><li><b>Đã gửi</b>: email đã được gửi đến máy chủ thư từ xa</li><li><b>Đã chuyển tiếp</b>: máy chủ thư từ xa báo rằng email đã được chuyển tiếp đến máy chủ kế tiếp</li><li><b>Bị trả lại</b>: email bị máy chủ thư từ xa trả lại, đây là lỗi không thể tiếp tục xử lý</li><li><b>Thất bại</b>: máy chủ thư từ xa không chấp nhận email của chúng ta, sẽ không thử lại</li><li><b>Thử gửi lại</b>: không thể gửi email và sẽ thử lại sau</li><li><b>Đã chặn</b>: địa chỉ email người nhận bị chặn, hãy kiểm tra trạng thái địa chỉ email</li><li><b>Đã nhận</b>: máy chủ thư từ xa đã gửi email cho chúng ta</li></ul>"

