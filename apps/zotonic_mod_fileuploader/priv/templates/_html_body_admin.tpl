{% lib "css/fileuploader-admin.css" "js/z.fileuploader-admin.js" %}
<div id="fileuploader-messages" hidden
     data-bytes="{_ bytes _}"
     data-max-size="{{ m.fileuploader.max_size }}"
     data-cancel="{_ Cancel remaining uploads _}"
     data-cancelled="{_ Cancelled _}"
     data-cancelled-summary="{_ Remaining uploads were cancelled. Files already saved have been kept. _}"
     data-oversized="{_ {filename} is too large. The maximum file size is {size}. _}"
     data-too-large="{_ This file exceeds the maximum upload size for your account. Choose a smaller file. _}"
     data-not-allowed="{_ This file type or size is not allowed for your account. _}"
     data-queued="{_ Waiting _}"
     data-processing="{_ Processing… _}"
     data-saved="{_ Saved _}"
     data-failed="{_ Upload failed _}"
     data-unattached="{_ Saved in Media, but could not attach. Use Add media item to connect it. _}"
     data-retry="{_ Retry failed files _}"
     data-refresh="{_ Refresh media list _}"
     data-transferring="{_ Uploading _}"
     data-summary="{_ {saved} of {total} files saved. _}"
     data-single="{_ Choose one file at a time for this upload. No files were uploaded. _}"
     data-folder="{_ Folders cannot be uploaded. Select the files inside the folder instead. _}"
     data-empty="{_ {filename} is empty. Choose a file with content. Folders cannot be uploaded. _}"
     data-accept="{_ {filename} has a file type that is not supported here. Choose a different file. _}"
     data-failure="{_ Upload failed. Please try again. _}"
     data-processing-failure="{_ Some files could not be processed. See the error messages. _}"
     data-finished="{_ Upload complete. Your files have been saved. _}"
     data-uploading="{_ Uploading and processing your files… Please keep this page open. _}"
     data-selected="{_ Ready to upload. Choose Upload file to save your selected file. _}"></div>
