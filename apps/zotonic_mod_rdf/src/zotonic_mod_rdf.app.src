{application, zotonic_mod_rdf, [
    {description, "RDF for Zotonic data."},
    {vsn, {file, "../../VERSION"}},
    {registered, []},
    {applications, [kernel, stdlib, zotonic_core, zotonic_jsonld, zotonic_turtle]},
    {env, []},
    {modules, []},
    {doc, "doc"},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"Website", "https://zotonic.com/"},
        {"GitHub", "https://github.com/zotonic/zotonic"}
    ]}
]}.
